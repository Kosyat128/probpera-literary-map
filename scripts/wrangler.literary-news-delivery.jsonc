{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "probpera-literary-news-delivery",
  "main": "./workers/literary-news-delivery-worker.mjs",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["0 5-19 * * *"] },
  "kv_namespaces": [{ "binding": "NEWS_STATE", "id": "f3ae59fd55ee4c0cac8ff1613db81680" }],
  "durable_objects": {"bindings":[{"name":"DELIVERY_COORDINATOR","class_name":"LiteraryNewsDeliveryCoordinator"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["LiteraryNewsDeliveryCoordinator"]}],
  "vars": { "NEWS_DELIVERY_ENABLED": "false" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
