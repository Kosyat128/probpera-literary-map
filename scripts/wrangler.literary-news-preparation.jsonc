{
  "$schema":"../node_modules/wrangler/config-schema.json",
  "name":"probpera-literary-news-preparation",
  "main":"./workers/literary-news-preparation-worker.mjs",
  "compatibility_date":"2026-09-30",
  "compatibility_flags":["nodejs_compat","global_fetch_strictly_public"],
  "workers_dev":false,
  "preview_urls":false,
  "triggers":{"crons":["17,47 * * * *"]},
  "kv_namespaces":[{"binding":"NEWS_STATE","id":"f3ae59fd55ee4c0cac8ff1613db81680"}],
  "ai":{"binding":"AI"},
  "durable_objects":{"bindings":[{"name":"PREPARATION_COORDINATOR","class_name":"DailyNewsPreparationCoordinator"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["DailyNewsPreparationCoordinator"]}],
  "vars":{"NEWS_AUTOMATION_ENABLED":"false","NEWS_AUTOMATION_WRITER":"native","NEWS_AUTOMATION_BOOTSTRAP":"false"},
  "observability":{"enabled":true,"head_sampling_rate":1}
}
