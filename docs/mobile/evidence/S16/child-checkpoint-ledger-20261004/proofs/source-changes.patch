+    }
+    try {
+      if (isAborted(signal)) throw unavailable();
+      if (signal) { EventTarget.prototype.addEventListener.call(signal, "abort", cancel, { once: true }); listener = true; }
+      current(); timer = setTimeout(cancel, Math.max(0, hostDeadline - hostTime()));
