+      completedCurrent(original, startedHost, startedLocal, signal);
+      return advanced;
+    },
+  });
+}
diff --git a/supabase/migrations/20261003203842_planet_child_checkpoint_ledger.sql b/supabase/migrations/20261003203842_planet_child_checkpoint_ledger.sql
