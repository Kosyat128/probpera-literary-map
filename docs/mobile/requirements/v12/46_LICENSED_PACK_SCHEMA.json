{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probpera.ru/schemas/mobile/licensed-pack-v12.json",
  "title": "Licensed Character Pack V12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "licensor",
    "agreement",
    "scope",
    "assets",
    "approvals",
    "commerce",
    "childPolicy",
    "expiry",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "licensor": {
      "type": "string"
    },
    "agreement": {
      "type": "object",
      "required": [
        "reference",
        "effectiveFrom",
        "effectiveTo"
      ],
      "properties": {
        "reference": {
          "type": "string"
        },
        "effectiveFrom": {
          "type": "string"
        },
        "effectiveTo": {
          "type": "string"
        },
        "evidenceLocation": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "characters",
        "platforms",
        "territories",
        "languages"
      ],
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "territories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rights": {
          "type": "array",
          "items": {
            "enum": [
              "display",
              "3d-model",
              "animation",
              "dialogue",
              "translation",
              "narration",
              "voice",
              "music",
              "marketing",
              "store-screenshots",
              "iap-sale"
            ]
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sha256",
          "approvalReference"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "approvalReference": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "status"
        ],
        "properties": {
          "type": {
            "enum": [
              "legal",
              "licensor-art",
              "licensor-product",
              "child-editorial",
              "marketing",
              "commerce",
              "store"
            ]
          },
          "status": {
            "enum": [
              "missing",
              "pending",
              "approved",
              "rejected"
            ]
          },
          "reference": {
            "type": "string"
          },
          "approvedAt": {
            "type": "string"
          }
        }
      }
    },
    "commerce": {
      "type": "object",
      "required": [
        "iapSalePermitted",
        "royaltyModel"
      ],
      "properties": {
        "iapSalePermitted": {
          "type": "boolean"
        },
        "royaltyModel": {
          "type": "string"
        },
        "minimumGuarantee": {
          "type": "string"
        },
        "reportingCadence": {
          "type": "string"
        },
        "platformSkus": {
          "type": "object"
        }
      }
    },
    "childPolicy": {
      "type": "object",
      "required": [
        "reviewStatus",
        "minimumAge",
        "maximumAge"
      ],
      "properties": {
        "reviewStatus": {
          "enum": [
            "not-reviewed",
            "approved",
            "rejected"
          ]
        },
        "minimumAge": {
          "type": "integer",
          "minimum": 3,
          "maximum": 17
        },
        "maximumAge": {
          "type": "integer",
          "minimum": 3,
          "maximum": 17
        }
      }
    },
    "expiry": {
      "type": "object",
      "required": [
        "postTermPolicy",
        "delistingLeadDays"
      ],
      "properties": {
        "postTermPolicy": {
          "enum": [
            "retain-existing",
            "stop-sales-retain-installed",
            "revoke-with-refund",
            "contract-specific"
          ]
        },
        "delistingLeadDays": {
          "type": "integer",
          "minimum": 0
        },
        "refundPolicy": {
          "type": "string"
        },
        "fallbackItemId": {
          "type": "string"
        }
      }
    },
    "status": {
      "enum": [
        "candidate",
        "license-required",
        "blocked",
        "implementation",
        "approval",
        "available",
        "delisted",
        "expired"
      ]
    }
  }
}
