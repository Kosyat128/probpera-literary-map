{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probpera.ru/schemas/mobile/requirements-traceability-v12-owner-minimal.json",
  "title": "Requirements Traceability V12 Owner-Minimal",
  "type": "object",
  "required": [
    "version",
    "generatedAt",
    "requirements"
  ],
  "properties": {
    "version": {
      "const": "12.0"
    },
    "generatedAt": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "summary",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "PASSED",
              "BLOCKED_INTERNAL",
              "BLOCKED_EXTERNAL",
              "WAIVED"
            ]
          },
          "implementationFiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commit": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
