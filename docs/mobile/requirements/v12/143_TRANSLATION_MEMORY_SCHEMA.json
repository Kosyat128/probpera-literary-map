{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probpera.ru/schemas/mobile/translation-memory-v12.json",
  "title": "Literary Planet Translation Memory V12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "memoryVersion",
    "sourceLocale",
    "targetLocale",
    "entries",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "12.0"
    },
    "memoryVersion": {
      "type": "string"
    },
    "sourceLocale": {
      "const": "ru"
    },
    "targetLocale": {
      "const": "en"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entryId",
          "source",
          "target",
          "sourceSha256",
          "domain",
          "status"
        ],
        "properties": {
          "entryId": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "domain": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "status": {
            "enum": [
              "approved",
              "review-required",
              "deprecated",
              "blocked"
            ]
          },
          "doNotReuseAcrossDomains": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
