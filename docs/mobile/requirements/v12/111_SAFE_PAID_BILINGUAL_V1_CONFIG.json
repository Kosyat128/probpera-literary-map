    "cloudAdultAccount": false,
    "cloudChildAccount": false,
    "cloudChildSync": false,
    "pushNotifications": false,
    "behaviouralAnalytics": false,
    "advertising": false,
    "openChat": false,
    "childAiInput": false,
    "microphone": false,
    "camera": false,
