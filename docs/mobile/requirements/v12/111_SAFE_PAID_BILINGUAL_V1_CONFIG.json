    "manualSubmission": true,
    "manualOrStagedRelease": true,
    "autoMerge": false,
    "productionDeploy": false
  },
  "cannotBeChangedByRemoteConfig": [
    "child-safety",
    "parent-gate",
    "rights-gate",
    "purchase-server-verification",
    "privacy-minimization",
