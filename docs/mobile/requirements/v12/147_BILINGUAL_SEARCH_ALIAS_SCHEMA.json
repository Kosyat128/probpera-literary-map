{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probpera.ru/schemas/mobile/search-alias-v12.json",
  "title": "Bilingual Search Alias V12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entityType",
    "entityId",
    "aliases",
    "policyStatus",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "12.0"
    },
    "entityType": {
      "enum": [
        "writer",
        "work",
        "country",
        "character",
        "place"
      ]
    },
    "entityId": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "value",
          "locale",
          "kind",
          "verified"
        ],
        "properties": {
          "value": {
            "type": "string"
          },
          "locale": {
            "enum": [
              "ru",
              "en",
              "und"
            ]
          },
          "kind": {
            "enum": [
              "display",
              "original",
              "published-title",
              "authority-form",
              "transliteration",
              "pseudonym",
              "surname-first",
              "initials",
              "historical",
              "search-only"
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "displayAllowed": {
            "type": "boolean"
          }
        }
      }
    },
    "policyStatus": {
      "enum": [
        "adult",
        "child-approved",
        "child-blocked",
        "unknown"
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
