+import { describe, expect, it, vi } from 'vitest';
+import sharp from 'sharp';
+import { normalizeNewsMedia, mediaByteHash } from './literary-news-media.mjs';
+import { prepareNewsPost, reconcileNewsSnapshot, newsPostKey, newsSemanticRevision,
+  newsSocialPayloadDigest, NEWS_SECTION_URL } from './literary-news-social.mjs';
+import { createNewsSocialTransport } from './literary-news-social-transport.mjs';
+import { buildPublishedNewsFeed } from './literary-news-publication.mjs';
+import { pendingNewsSourceState } from './literary-news-state.mjs';
+
+const now = new Date('2026-09-30T10:00:00Z');
+const destination = { platform: 'telegram', id: '-100123', mode: 'on' };
+const snapshot = { id: 'footer-fixture', release: 'a'.repeat(40) };
+const brand = 'Литературная повестка «Пробы пера»';
+const item = { id: 'footer-fixture', eventKey: 'footer-fixture', category: 'releases', kind: 'news',
+  eventDate: '2026-09-30', publishedAt: '2026-09-30T09:00:00Z', verifiedAt: now.toISOString(),
+  verification: 'confirmed', title: { ru: '📚 Новая книга 😀', en: 'A new book' },
+  summary: { ru: 'Издатель сообщил о книге. 👩🏽‍💻 Читатели увидят её осенью.', en: 'The publisher announced a book.' },
+  source: { name: 'ActuaLitté', url: 'https://publisher.example/literary-news', language: 'fr' } };
+
+async function mediaFixture(news, credit = 'Synthetic image © Fixture') {
+  const source = await sharp({ create: { width: 480, height: 640, channels: 3, background: '#8f7788' } }).png().toBuffer();
+  const normalized = await normalizeNewsMedia(source, 'image/png');
+  const asset = { id: 'footer-image', status: 'approved', newsIds: [news.id],
+    sourceUrl: 'https://publisher.example/photo.png', sourceSha256: mediaByteHash(source), subject: 'book',
+    entityEvidence: 'Synthetic fixture only; never a real book cover.', author: 'Fixture', rightsholder: 'Fixture', credit,
+    license: 'owned', licenseEvidenceUrl: 'https://publisher.example/fixture-license', licenseEvidenceSha256: 'a'.repeat(64),
+    checkMethod: 'ownership-record', checkedAt: '2026-09-30T00:00:00Z', validUntil: '2026-10-20T00:00:00Z',
+    transformations: { resize: true, metadataRemoval: true, reencode: true, crop: false },
+    permissions: [{ platform: 'telegram', destinationId: destination.id, publish: true, providerProcessing: true,
+      evidenceUrl: 'https://publisher.example/fixture-license' }], derivative: normalized.descriptor };
+  return { registry: { assets: [asset], downloadHosts: ['publisher.example'] }, now, readBytes: async () => normalized.bytes };
+}
+
+function assertFooter(prepared, news) {
+  const body = prepared.payload.caption ?? prepared.payload.text;
+  const entities = prepared.payload.caption_entities ?? prepared.payload.entities;
+  const links = entities.filter(entity => entity.type === 'text_link');
+  expect(links).toHaveLength(2);
+  expect(links.map(entity => entity.url)).toEqual([news.source.url, NEWS_SECTION_URL]);
+  expect(body.slice(links[0].offset, links[0].offset + links[0].length)).toBe(news.source.name);
+  expect(body.slice(links[1].offset, links[1].offset + links[1].length)).toBe(brand);
+  expect(links[0].length).toBe(Buffer.from(news.source.name, 'utf16le').length / 2);
+  expect(links[1].length).toBe(Buffer.from(brand, 'utf16le').length / 2);
+  expect(body.slice(links[0].offset - 'Источник: '.length, links[0].offset)).toBe('Источник: ');
+  expect(body.slice(links[0].offset + links[0].length, links[1].offset)).toBe('\n\n');
+  expect(body).toContain(news.title.ru);
+  expect(body).toContain(news.summary.ru);
+  expect(body).not.toContain(news.source.url);
+  expect(body).not.toContain(NEWS_SECTION_URL);
+  const prefix = body.lastIndexOf('Источник: ');
+  expect(entities.every(entity => entity.offset + entity.length <= prefix || entity.offset >= prefix + 'Источник: '.length)).toBe(true);
+  expect(entities[0]).toMatchObject({ type: 'bold', offset: 0, length: Buffer.from(news.title.ru, 'utf16le').length / 2 });
+}
+
+function memoryStore() {
+  const rows = new Map(); let sequence = 0;
+  return { async read(key) { return structuredClone(rows.get(key) ?? { id: null, state: null }); },
+    async list(prefix) { return [...rows].filter(([key]) => key.startsWith(prefix)).map(([, row]) => structuredClone(row)); },
+    async compareAppend(key, expected, state) {
+      const previous = await this.read(key);
+      if (previous.id !== expected) return { applied: false, ...previous };
+      const next = { id: ++sequence, state: structuredClone(state) }; rows.set(key, next);
+      return { applied: true, ...structuredClone(next) };
+    }, async seed(key, state) { return this.compareAppend(key, (await this.read(key)).id, state); } };
+}
+
+async function legacyPhotoFixture(kind = 'news') {
+  const news = { ...item, kind }, store = memoryStore(), mediaOptions = await mediaFixture(news);
+  const feed = await buildPublishedNewsFeed({ records: [news], withdrawals: [], current: now,
+    release: snapshot.release, timeZone: 'Europe/Moscow', state: pendingNewsSourceState([]) });
+  await reconcileNewsSnapshot(store, feed, [destination], now, { mediaOptions });
+  const key = newsPostKey(news.id, destination), original = (await store.read(key)).state;
+  const formatRevision = kind === 'news' ? 'news-without-event-date-v1' : undefined;
+  const messageRevision = formatRevision ? await newsSocialPayloadDigest({ textRevision: original.prepared.textRevision, formatRevision })
+    : original.prepared.textRevision;
+  const media = original.prepared.media;
+  const revision = await newsSocialPayloadDigest({ textRevision: messageRevision, media: {
+    assetId: media.assetId, sha256: media.sha256, profile: media.profile, credit: media.credit,
+    licenseEvidenceSha256: media.licenseEvidenceSha256, destination: media.destination,
+  } });
+  const state = { ...original, status: 'sent_current', remoteId: '17', remoteMediaKind: 'photo',
+    remoteUrl: 'https://t.me/c/123/17', acknowledgedRevision: revision, desiredRevision: revision,
+    mediaCache: { platform: 'telegram', destinationId: destination.id, providerAccountId: '123',
+      sha256: media.sha256, fileId: 'fixture_file_id' },
+    prepared: { ...original.prepared, formatRevision, revision } };
+  await store.seed(key, state);
+  return { news, store, mediaOptions, feed, key, state };
+}
