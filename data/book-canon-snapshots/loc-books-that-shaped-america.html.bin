        <li><a href="http://www.loc.gov/exhibits/books-that-shaped-america/1950-to-2000.html#obj3">Ray Bradbury (1920&ndash;2012). <em>Fahrenheit 451.</em> New York: Ballantine Books, 1953.</a> General Collections, Library of Congress (078.00.00)</li>
        <li><a href="http://www.loc.gov/exhibits/books-that-shaped-america/1950-to-2000.html#obj4">Allen Ginsberg (1926&ndash;1997). <em>Howl and Other Poems.</em> San Francisco: City Lights Pocket Bookshop, 1956.</a> Rare Book and Special Collections Division, Library of Congress (079.00.00)</li>
        <li><a href="http://www.loc.gov/exhibits/books-that-shaped-america/1950-to-2000.html#obj5">Ayn Rand (1905&ndash;1982). <em>Atlas Shrugged.</em> New York: Random House, 1957.</a> General Collections, Library of Congress (080.00.00)</li>
        <li><a href="http://www.loc.gov/exhibits/books-that-shaped-america/1950-to-2000.html#obj6">Theodor Geisel (Dr. Seuss, 1904&ndash;1991). <em>The Cat in the Hat.</em> New York: Random House, 1957.</a> Rare Book and Special Collections Division, Library of Congress (081.00.00)</li>
        <li><a href="http://www.loc.gov/exhibits/books-that-shaped-america/1950-to-2000.html#obj7">Jack Kerouac (1922&ndash;1969). <em>On the Road.</em> New York: Viking Press, 1957.</a> Rare Book and Special Collections Division, Library of Congress (082.00.00)</li>
        <li><a href="http://www.loc.gov/exhibits/books-that-shaped-america/1950-to-2000.html#obj8">Harper Lee (b. 1926). <em>To Kill a Mockingbird.</em> Philadelphia: J. B. Lippincott, 1960.</a> Rare Book and Special Collections Division, Library of Congress (083.00.00)</li>
        <li><a href="http://www.loc.gov/exhibits/books-that-shaped-america/1950-to-2000.html#obj9">Joseph Heller (1888&ndash;1957). <em>Catch-22.</em> London: Jonathan Cape, 1962.</a> Rare Book and Special Collections Division, Library of Congress (084.00.00)</li>
        <li><a href="http://www.loc.gov/exhibits/books-that-shaped-america/1950-to-2000.html#obj10">Robert A. Heinlein (1907&ndash;1988). <em>Stranger in a Strange Land.</em> New York: Putman, 1961.</a> General Collections, Library of Congress (085.00.00)</li>
        <li><a href="http://www.loc.gov/exhibits/books-that-shaped-america/1950-to-2000.html#obj11">Ezra Jack Keats (1916&ndash;1983). <em>The Snowy Day.</em> New York: Viking, 1962.</a> Rare Book and Special Collections Division, Library of Congress (086.00.00)</li>
        <li><a href="http://www.loc.gov/exhibits/books-that-shaped-america/1950-to-2000.html#obj12">Rachel Carson (1907&ndash;1964). <em>Silent Spring.</em> Boston: Houghton Mifflin, 1962.</a> Rare Book and Special Collections Division, Library of Congress (092.00.00)</li>
        <li><a href="http://www.loc.gov/exhibits/books-that-shaped-america/1950-to-2000.html#obj13">Maurice Sendak (1928&ndash;2012). <em>Where the Wild Things Are.</em> New York: Harper &amp; Row, 1963.</a> Rare Book and Special Collections Division, Library of Congress (087.00.00)</li>
        <li><a href="http://www.loc.gov/exhibits/books-that-shaped-america/1950-to-2000.html#obj14">James Baldwin (1924&ndash;1987). <em>The Fire Next Time.</em> New York: Dial, 1963.</a> Rare Book and Special Collections Division, Library of Congress (088.00.00)</li>
        <li><a href="http://www.loc.gov/exhibits/books-that-shaped-america/1950-to-2000.html#obj15">Betty Friedan (1921&ndash;2006). <em>The Feminine Mystique.</em> New York: Laurel, 1984.</a> General Collections, Library of Congress (089.00.00)</li>
        <li><a href="http://www.loc.gov/exhibits/books-that-shaped-america/1950-to-2000.html#obj16">Malcolm X (1925&ndash;1965) and Alex Haley (1921&ndash;1992). <em>The Autobiography of Malcolm X.</em> New York: Grove Press, 1965.</a> General Collections, Library of Congress (090.00.00) </li>
