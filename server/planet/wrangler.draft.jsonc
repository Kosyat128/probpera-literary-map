{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "literary-planet-v12-preparation",
  "main": "worker.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Local preparation only. No account IDs, routes, deployment scripts or keys.
  // Host must explicitly supply every PLANET_API_ENV_KEYS setting from worker.ts;
  // reuse the canonical SUPABASE_URL and publishable key, with server-only secrets.
  "vars": {},
  "assets": {
    "directory": "../../dist-pwa",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": { "enabled": false }
}
