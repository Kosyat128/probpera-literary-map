{
  "name": "literary-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "workspaces": [
    "apps/admin"
  ],
  "overrides": {
    "postcss": "8.5.24",
    "@react-three/drei": {
      "three-mesh-bvh": "0.8.3"
    },
    "stats-gl": {
      "three": "0.178.0"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run content:export:cms && npm run build:from-snapshot",
    "build:from-snapshot": "npm run interface:copy:catalog && npm run assets:globe:modern && npm run assets:globe:qa && npm run content:link-books && tsc && vite build && node scripts/build-article-pages.mjs",
    "build:all": "npm run build && npm run admin:build",
    "build:domain": "node scripts/build-domain-release.mjs",
    "domain:audit": "node scripts/audit-domain-release.mjs",
    "seo:audit": "node scripts/audit-seo-release.mjs",
    "analytics:config:check": "node scripts/audit-analytics-config.mjs",
    "release:check": "npm run lint && npm test && npm run community:config:check && npm run analytics:config:check && npm run interface:language:audit && npm run content:audit && npm run editorial:language:audit && npm run links:audit && npm run media:audit && npm run books:audit && npm run countries:audit && npm run writers:biographies:reviews:check && npm run writers:biographies:facts:qa && npm run writers:identities:check && npm run writers:nobel:check && npm run covers:audit && npm run assets:globe:qa && npm run admin:build && npm run build:domain && npm run performance:audit",
    "release:smoke:live": "node scripts/audit-live-security.mjs",
    "performance:audit": "node scripts/audit-performance-budget.mjs",
    "backup:storage": "node scripts/backup-supabase-storage.mjs",
    "preview": "vite preview",
    "preview:domain": "node scripts/serve-dist.mjs",
    "admin:dev": "npm run dev --workspace @probpera/admin",
    "admin:build": "npm run editorial:catalog && npm run build --workspace @probpera/admin",
    "admin:start": "npm run start --workspace @probpera/admin",
    "admin:serve": "npm run admin:build && npm run admin:start",
    "admin:cf:build": "npm run cf:build --workspace @probpera/admin",
    "admin:cf:preview": "npm run cf:preview --workspace @probpera/admin",
    "admin:cf:deploy": "npm run cf:deploy --workspace @probpera/admin",
    "admin:cf:upload": "npm run cf:upload --workspace @probpera/admin",
    "admin:cf:typegen": "npm run cf:typegen --workspace @probpera/admin",
    "lint": "npm run lint:public && npm run lint --workspace @probpera/admin",
    "lint:public": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "content:crawl": "node scripts/crawl-probpera.mjs",
    "content:audit": "node scripts/audit-articles.mjs",
    "editorial:language:audit": "node scripts/audit-editorial-language.mjs",
    "interface:language:audit": "node scripts/audit-interface-i18n.mjs",
    "interface:copy:catalog": "node scripts/export-interface-copy-catalog.mjs",
    "editorial:catalog": "node scripts/export-editorial-catalog.mjs",
    "editorial:catalog:check": "node scripts/export-editorial-catalog.mjs --check",
    "interface:copy:catalog:check": "node scripts/export-interface-copy-catalog.mjs --check",
    "community:config:check": "node scripts/audit-community-config.mjs",
    "content:fix-confirmed": "node scripts/apply-editorial-fixes.mjs",
    "content:normalize-titles": "node scripts/normalize-article-titles.mjs",
    "content:derived-text:check": "node scripts/normalize-article-derived-text.mjs",
    "content:derived-text:fix": "node scripts/normalize-article-derived-text.mjs --write",
    "content:metadata:check": "node scripts/normalize-cms-snapshot-metadata.mjs",
    "content:metadata:fix": "node scripts/normalize-cms-snapshot-metadata.mjs --write",
    "content:normalize-book-titles": "node scripts/normalize-generated-book-titles.mjs",
    "content:link-books": "node scripts/build-book-article-mentions.mjs",
    "content:link-books:scope-check": "node scripts/build-book-article-mentions.mjs --check-user-cover-scope",
    "content:publish-scheduled": "node scripts/publish-scheduled-content.mjs",
    "content:social:publish": "node scripts/publish-social-content.mjs",
    "content:social:preview": "node scripts/publish-social-content.mjs --dry-run",
    "content:import:cms": "node scripts/import-articles-to-supabase.mjs --dry-run",
    "content:export:cms": "node --env-file-if-exists=.env.local scripts/export-stable-published-content.mjs",
    "content:publication:head-check": "node scripts/verify-publication-deploy-head.mjs",
    "content:publication:coalesce": "node scripts/coalesce-publication-followup.mjs",
    "content:normalize:cms": "node scripts/normalize-cms-publications.mjs",
    "links:audit": "node scripts/audit-public-routes.mjs && node scripts/normalize-article-derived-text.mjs && node scripts/normalize-cms-snapshot-metadata.mjs",
    "media:audit": "node scripts/audit-section-media.mjs",
    "media:audit:legacy": "node scripts/audit-legacy-article-media.mjs",
    "countries:import": "node scripts/import-wikidata-writers.mjs --target=4000",
    "countries:import:apply": "node scripts/import-wikidata-writers.mjs --target=4000 --apply",
    "countries:audit": "node scripts/audit-country-database.mjs && node scripts/audit-generated-writers.mjs && node scripts/audit-writer-biographies.mjs && vitest run src/countryArchive.test.ts src/data/countryDataQuality.test.ts src/data/countries/writerBiographyResearchBatch01.test.ts",
    "writers:biographies:audit": "node scripts/audit-writer-biographies.mjs",
    "writers:biographies:check": "node scripts/audit-writer-biographies.mjs && vitest run src/data/writerBiography.test.ts src/data/countries/writerBiographyResearchBatch01.test.ts src/writerImportSafety.test.ts",
    "writers:biographies:facts:qa": "node scripts/audit-writer-biography-facts.mjs && vitest run scripts/lib/writer-biography-fact-qa.test.mjs scripts/lib/wikidata-writer-facts.test.mjs src/data/countries/writerFactCorrections.test.ts",
    "writers:biographies:reviews:build": "node scripts/build-writer-biography-fact-review-overlay.mjs --write",
    "writers:biographies:reviews:check": "node scripts/build-writer-biography-fact-review-overlay.mjs --check && vitest run src/data/countries/writerBiographyFactReviews.test.ts",
    "writers:biographies:reviews:report": "node --experimental-strip-types scripts/generate-writer-biography-fact-review-report.ts",
    "writers:wikidata:facts:refresh": "node scripts/refresh-wikidata-writer-facts.mjs --write",
    "writers:wikidata:facts:check": "node scripts/refresh-wikidata-writer-facts.mjs --check && vitest run scripts/lib/wikidata-writer-facts.test.mjs",
    "writers:identities:audit": "node scripts/audit-curated-writer-identities.mjs",
    "writers:identities:check": "node scripts/audit-curated-writer-identities.mjs --check && vitest run scripts/lib/curated-writer-identity.test.mjs scripts/lib/writer-identity-audit.test.mjs src/data/countries/writerIdentityRegistry.test.ts",
    "writers:nobel:audit": "node scripts/audit-nobel-literature-archive.mjs && vitest run src/data/nobel.test.ts",
    "writers:nobel:check": "node scripts/refresh-official-nobel-literature.mjs --check && node scripts/audit-nobel-literature-archive.mjs --check && vitest run src/data/nobel.test.ts",
    "writers:nobel:refresh": "node scripts/refresh-official-nobel-literature.mjs --write",
    "writers:facts:audit": "node scripts/audit-generated-writer-facts.mjs",
    "writers:facts:apply": "node scripts/audit-generated-writer-facts.mjs --apply",
    "writers:portraits:audit": "node scripts/sync-writer-portraits.mjs",
    "writers:portraits:apply": "node scripts/sync-writer-portraits.mjs --apply",
    "writers:qids:audit": "node scripts/resolve-curated-writer-qids.mjs",
    "writers:qids:apply": "node scripts/resolve-curated-writer-qids.mjs --apply",
    "covers:audit": "node scripts/audit-cover-rights.mjs && npm run covers:user:check",
    "covers:user:check": "node scripts/import-user-supplied-book-covers.mjs --check && node scripts/import-user-supplied-book-covers-2026-08-13.mjs --check && node scripts/import-user-supplied-book-covers-2026-08-20.mjs --check && npm run content:link-books:scope-check",
    "books:audit": "node scripts/audit-book-database.mjs && node scripts/audit-article-book-coverage.mjs && npm run books:enrichment:check",
    "books:enrichment:build": "node scripts/build-book-enrichment-manifest.mjs --write",
    "books:enrichment:check": "node scripts/build-book-enrichment-manifest.mjs --check && vitest run scripts/lib/book-enrichment-policy.test.mjs scripts/lib/book-enrichment-promotion.test.mjs scripts/lib/book-enrichment-generator.test.mjs scripts/lib/book-enrichment-curated-batch-01.test.mjs scripts/lib/book-publication-sql.test.mjs src/data/bookArchive.test.ts src/data/countries/generated/generatedBooks.types.test.ts",
    "books:sync": "node scripts/sync-literary-archive.mjs",
    "books:sync:apply": "node scripts/sync-literary-archive.mjs --apply",
    "books:sync:covers-20260820": "node scripts/sync-literary-archive.mjs --batch-2026-08-20",
    "books:sync:covers-20260820:preflight": "node scripts/sync-literary-archive.mjs --batch-2026-08-20 --preflight",
    "books:sync:covers-20260820:apply": "node scripts/sync-literary-archive.mjs --batch-2026-08-20 --apply",
    "books:import:wikidata": "node scripts/import-wikidata-books.mjs --target=10000",
    "books:import:wikidata:apply": "node scripts/import-wikidata-books.mjs --target=10000 --apply",
    "books:import:openlibrary": "node scripts/import-openlibrary-books.mjs --target=10000",
    "books:import:openlibrary:apply": "node scripts/import-openlibrary-books.mjs --target=10000 --apply",
    "assets:globe": "node scripts/build-antique-globe-texture.mjs",
    "assets:globe:modern:source": "node scripts/prepare-modern-globe-source.mjs",
    "assets:globe:modern:labels": "node scripts/sync-modern-globe-labels.mjs",
    "assets:globe:modern": "node scripts/build-modern-globe-texture.mjs",
    "assets:globe:qa": "node scripts/qa-globe-alignment.mjs"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@supabase/supabase-js": "2.112.3",
    "gsap": "^3.13.0",
    "leaflet": "^1.9.4",
    "react": "19.2.8",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "three": "0.178.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.178.0",
    "@vitejs/plugin-react": "^5.1.4",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "sharp": "0.35.3",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260811.1": true
  }
}
