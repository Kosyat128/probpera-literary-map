VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public Cloudflare Turnstile site key. Enable the matching secret in
# Supabase Auth > Bot and Abuse Protection before setting this value.
VITE_TURNSTILE_SITE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
BACKUP_ENCRYPTION_KEY=

SOCIAL_REQUIRED_PLATFORMS=dzen
SOCIAL_ENABLE_VK_AUTOPUBLISH=false
# Optional operator-only VK path. Standard workflows never pass these values.
VK_GROUP_ID=
# Community token fallback for an explicitly enabled manual run.
VK_GROUP_ACCESS_TOKEN=
# Administrator token with wall and photos permissions for a manual run.
VK_USER_ACCESS_TOKEN=
# Legacy community-token fallback; retained for backwards-compatible manual use.
VK_ACCESS_TOKEN=
OK_GROUP_ID=
OK_APPLICATION_KEY=
OK_ACCESS_TOKEN=
OK_SESSION_SECRET_KEY=
DZEN_RSS_URL=https://probpera.ru/rss.xml

VITE_BOOSTY_URL=https://boosty.to/probpera
VITE_PUBLIC_SITE_URL=https://probpera.ru
PUBLIC_SITE_URL=https://probpera.ru
PUBLIC_SITE_ORIGIN=https://probpera.ru
PUBLIC_SITE_BASE_PATH=/

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://probpera.ru
NEXT_PUBLIC_ADMIN_URL=https://admin.probpera.ru
ADMIN_BASE_PATH=/
ADMIN_ALLOWED_ORIGINS=admin.probpera.ru
PUBLIC_SITE_DEPLOY_HOOK_URL=
PUBLIC_SITE_DEPLOY_HOOK_TOKEN=
GITHUB_DEPLOY_TOKEN=
GITHUB_DEPLOY_REPOSITORY=Kosyat128/probpera-literary-map
GITHUB_DEPLOY_WORKFLOW=deploy-pages.yml
GITHUB_DEPLOY_REF=main

GOOGLE_BOOKS_API_KEY=
# Server-only OpenAI Platform key. Never expose it through NEXT_PUBLIC_* or VITE_*.
OPENAI_API_KEY=
# Premium English uses a first translation pass and a second editorial review pass.
OPENAI_TRANSLATION_MODEL=gpt-5.6-sol
OPENAI_TRANSLATION_REVIEW_MODEL=gpt-5.6-sol
OPENAI_PREMIUM_TRANSLATION_REVIEW=true
OPENAI_AUTO_TRANSLATE_ARTICLES=true
OPENAI_AUTO_TRANSLATE_LIBRARY=true
OPENAI_AUTO_TRANSLATE_SITE_COPY=true
OPENAI_AUTO_TRANSLATE_PROFILES=true
# Public numeric ID of the single probpera.ru counter. Leave empty to disable;
# never substitute a demo or guessed counter.
YANDEX_METRIKA_COUNTER_ID=
